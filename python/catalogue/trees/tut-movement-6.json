{
  "name": "tut-movement-6",
  "owner": "matt",
  "root": {
    "kind": "BOOLEAN",
    "inputs": [{"name": "VALID_POSITION", "args": ["SECONDARY"]}],
    "children": [
      {"kind": "OUTPUT", "action": "CHANGE_TREE", "args": ["tut-movement-6-secondary"]},
      {
        "kind": "BOOLEAN",
        "inputs": [{"name": "VALID_POSITION", "args": ["PRIMARY"]}],
        "children": [
          {
            "kind": "POSITION",
            "inputs": [{"name": "DIRECTION_TO", "args": ["PRIMARY"]}],
            "children": [
              {
                "kind": "BOOLEAN",
                "inputs": [{"name": "VALID_POSITION", "args": ["LEFT"]}],
                "children": [
                  {"kind": "OUTPUT", "action": "MOVE_LEFT"},
                  {"kind": "OUTPUT", "action": "SET_SECONDARY", "args": ["CURRENT"]}
                ]
              },
              {
                "kind": "BOOLEAN",
                "inputs": [{"name": "VALID_POSITION", "args": ["RIGHT"]}],
                "children": [
                  {"kind": "OUTPUT", "action": "MOVE_RIGHT"},
                  {"kind": "OUTPUT", "action": "SET_SECONDARY", "args": ["CURRENT"]}
                ]
              },
              {
                "kind": "BOOLEAN",
                "inputs": [{"name": "VALID_POSITION", "args": ["UP"]}],
                "children": [
                  {"kind": "OUTPUT", "action": "MOVE_UP"},
                  {"kind": "OUTPUT", "action": "SET_SECONDARY", "args": ["CURRENT"]}
                ]
              },
              {
                "kind": "BOOLEAN",
                "inputs": [{"name": "VALID_POSITION", "args": ["DOWN"]}],
                "children": [
                  {"kind": "OUTPUT", "action": "MOVE_DOWN"},
                  {"kind": "OUTPUT", "action": "SET_SECONDARY", "args": ["CURRENT"]}
                ]
              },
              {"kind": "OUTPUT", "action": "CONFUSED"}
            ]
          },
          {"kind": "OUTPUT", "action": "SET_PRIMARY", "args": [{"x": 6, "y": 5}]}
        ]
      }
    ]
  }
}
