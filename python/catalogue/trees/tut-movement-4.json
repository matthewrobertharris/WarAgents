{
  "name": "tut-movement-4",
  "owner": "matt",
  "root": {
    "kind": "BOOLEAN",
    "inputs": [{"name": "VALID_POSITION", "args": ["PRIMARY"]}],
    "children": [
      {
        "kind": "POSITION",
        "inputs": [{"name": "DIRECTION_TO", "args": ["PRIMARY"]}],
        "children": [
          {
            "kind": "BOOLEAN",
            "inputs": [{"name": "VALID_POSITION", "args": ["LEFT"]}],
            "children": [{"kind": "OUTPUT", "action": "MOVE_LEFT"}, {"kind": "OUTPUT", "action": "MOVE_DOWN"}]
          },
          {
            "kind": "BOOLEAN",
            "inputs": [{"name": "VALID_POSITION", "args": ["RIGHT"]}],
            "children": [{"kind": "OUTPUT", "action": "MOVE_RIGHT"}, {"kind": "OUTPUT", "action": "MOVE_DOWN"}]
          },
          {
            "kind": "BOOLEAN",
            "inputs": [{"name": "VALID_POSITION", "args": ["UP"]}],
            "children": [{"kind": "OUTPUT", "action": "MOVE_UP"}, {"kind": "OUTPUT", "action": "MOVE_DOWN"}]
          },
          {
            "kind": "BOOLEAN",
            "inputs": [{"name": "VALID_POSITION", "args": ["DOWN"]}],
            "children": [{"kind": "OUTPUT", "action": "MOVE_DOWN"}, {"kind": "OUTPUT", "action": "MOVE_DOWN"}]
          },
          {"kind": "OUTPUT", "action": "CONFUSED"}
        ]
      },
      {"kind": "OUTPUT", "action": "SET_PRIMARY", "args": [{"x": 7, "y": 5}]}
    ]
  }
}
